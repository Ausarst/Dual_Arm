<launch>
  <!-- CAN port of each arm, must match can_activate.sh binding (usb address) -->
  <arg name="arm1_can_port" default="can0"/>
  <arg name="arm2_can_port" default="can1"/>
  <arg name="arm1_auto_enable" default="false"/>
  <arg name="arm2_auto_enable" default="false"/>

  <!-- Arm1 -->
  <group ns="arm1">
    <!-- Arm initial -->
    <include file="$(find piper)/launch/all_start_multiple_piper.launch">
      <arg name="can_port" value="$(arg arm1_can_port)"/>
      <arg name="auto_enable" value="$(arg arm1_auto_enable)"/>
      <arg name="gripper_val_mutiple" value="1"/>
      <arg name="girpper_exist" value="true"/>
    </include>

    <!-- Load cam&arm urdf -->
    <param name="robot_description"
        command="$(find xacro)/xacro $(find piper)/urdf/arm_with_camera.urdf.xacro" />

    <!-- TF tree -->
    <node 
      name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
      <remap from="joint_states" to="joint_states_hggd"/>
      <!-- <remap from="/joint_states" to="/joint_states_hggd"/> -->
      <param name="tf_prefix" value="arm1"/>
    </node>

  </group>

  <!-- Arm2 -->
  <group ns="arm2">
    <include file="$(find piper)/launch/all_start_multiple_piper.launch">
      <arg name="can_port" value="$(arg arm2_can_port)"/>
      <arg name="auto_enable" value="$(arg arm2_auto_enable)"/>
      <arg name="gripper_val_mutiple" value="1"/>
      <arg name="girpper_exist" value="true"/>
    </include>

    <!-- Load cam&arm urdf -->
    <param name="robot_description"
        command="$(find xacro)/xacro $(find piper)/urdf/arm_with_camera.urdf.xacro" />

    <!-- TF tree -->
    <node 
      name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
      <remap from="joint_states" to="joint_states_hggd"/>
      <!-- <remap from="/joint_states" to="/joint_states_single"/> -->
      <!-- <remap from="/joint_states" to="/joint_states_hggd"/> -->
      <param name="tf_prefix" value="arm2"/>
    </node>

  </group>

<!-- Be sure that since you remap the joint states in hggd_endpose.py, now you need both subscrib and publish two topics with prefix /arm1 & /arm2 -->
<!-- Besides, for all script in name space, subscriber also add prefix, that means you need send two control pose to agile_armpose.py -->

  <!-- Camera mount bridges ONLY: connect {cam}_link (driver tree root) into the arm tree.
       The optical edges {cam}_link -> {cam}_color_optical_frame are published by the REAL
       driver with factory calibration, never republish them here (identity stand-ins exist
       only in 2arm_dryrun.launch where no driver runs).
       Driver launched separately: rs_camera_hggd.launch camera:=arm1_cam
       (rs_camera_arm.launch is the self-contained alternative, it already includes this
       bridge, so do not double-publish when using it). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="arm1_link6_to_arm1_cam_link"
        args="-0.055 0 0.06 0 -1.5708 0 arm1/link6 arm1_cam_link" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="arm2_link6_to_arm2_cam_link"
        args="-0.055 0 0.06 0 -1.5708 0 arm2/link6 arm2_cam_link" />

  <!-- World base frame -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_arm1_base"
        args="0 0 0 0 0 0 world arm1/arm_base" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_arm2_base"
        args="0 0.4 0 0 0 0 world arm2/arm_base" />
  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_arm2_base"
        args="0 -0.4 0 0 0 1.5708 world arm2/arm_base" /> -->

  <!-- RViz -->
  <arg name="rviz_config" default="$(find piper_description)/rviz/arm_camera.rviz"/>
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" />
</launch>
